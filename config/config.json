{
  // 上游同步源列表，可继续在这里追加自定义链接。
  "sources": [
    {
      // 源名称，同时用于生成文件名。
      "name": "acl4ssr-clash",
      // github_directory 表示同步 GitHub 文件夹；rule_list 表示同步单个文本文件。
      "type": "github_directory",
      "upstream_url": "https://github.com/ACL4SSR/ACL4SSR/tree/master/Clash",
      // GitHub Contents API 地址，不是普通网页地址。
      "api_url": "https://api.github.com/repos/ACL4SSR/ACL4SSR/contents/Clash?ref=master",
      // 使用一次性 ZIP，减少递归 Contents API 请求并避免 GitHub API 限流。
      "archive_url": "https://github.com/ACL4SSR/ACL4SSR/archive/refs/heads/master.zip",
      // 去掉上游路径前缀后，保留其余文件夹结构。
      "path_prefix": "Clash",
      // 是否递归同步子文件夹。
      "recursive": true,
      // 只同步这些扩展名的文件。
      "include_extensions": [
        ".list",
        ".yaml",
        ".yml"
      ],
      // 不同步这些目录前缀。
      "exclude_prefixes": [
        "Clash/config",
        "Clash/mrs"
      ],
      // 不同步这些文件名。
      "exclude_names": [
        "GeneralClashConfig.yml"
      ],
      // 生成文件的根目录。
      "output_dir": "data/acl4ssr",
      // 所有文件合并后的域名总表；没有域名内容时不会生成。
      "merged_domain_output": "data/acl4ssr/all_domain.txt",
      // 所有文件合并后的 IPv4/CIDR 总表；没有 ISP 内容时不会生成。
      "merged_isp_output": "data/acl4ssr/all_isp.txt",
      // 单个请求的超时时间，单位为秒。
      "timeout_seconds": 30,
      // 请求 GitHub API 时使用的请求头。
      "headers": {
        "Accept": "application/vnd.github+json"
      }
    },
    {
      // Loyalsoldier 代理规则：域名写入 _domain.txt，IPv4/CIDR 写入 _isp.txt。
      "name": "proxy-list",
      "type": "rule_list",
      "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/proxy-list.txt",
      // 多个文本源可以共用同一个输出目录。
      "output_dir": "data/v2ray-rules-dat",
      "timeout_seconds": 30
    },
    {
      // Loyalsoldier Google CN 规则。
      "name": "google-cn",
      "type": "rule_list",
      "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/google-cn.txt",
      "output_dir": "data/v2ray-rules-dat",
      "timeout_seconds": 30
    },
    {
      // Loyalsoldier GFW 规则：每行一个完整域名。
      "name": "gfw",
      "type": "rule_list",
      "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/gfw.txt",
      "output_dir": "data/v2ray-rules-dat",
      "timeout_seconds": 30
    },
    {
      // Loyalsoldier 直连 规则：每行一个完整域名。
      "name": "direct-list",
      "type": "rule_list",
      "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/direct-list.txt",
      "output_dir": "data/v2ray-rules-dat",
      "timeout_seconds": 30
    },
    {
      // BlackMatrix7 Clash 规则目录，保留上游目录和文件扩展名，避免同名 .list/.yaml 覆盖。
      "name": "blackmatrix7-clash",
      "type": "github_directory",
      "upstream_url": "https://github.com/blackmatrix7/ios_rule_script/tree/master/rule/Clash",
      "api_url": "https://api.github.com/repos/blackmatrix7/ios_rule_script/contents/rule/Clash?ref=master",
      "archive_url": "https://github.com/blackmatrix7/ios_rule_script/archive/refs/heads/master.zip",
      "path_prefix": "rule/Clash",
      "recursive": true,
      "include_extensions": [
        ".list",
        ".yaml",
        ".yml"
      ],
      "include_source_extension": true,
      "output_dir": "data/blackmatrix7",
      "merged_domain_output": "data/blackmatrix7/all_domain.txt",
      "merged_isp_output": "data/blackmatrix7/all_isp.txt",
      "timeout_seconds": 30,
      "headers": {
        "Accept": "application/vnd.github+json"
      }
    }
  ],
  // 生成所有同步源合并后的代理专用列表，并排除中国域名和中国 IPv4/CIDR。
  "proxy_aggregate": {
    "enabled": true,
    "input_dirs": [
      "data/acl4ssr",
      "data/v2ray-rules-dat",
      "data/blackmatrix7"
    ],
    "output_dir": "data/proxy",
    "domain_output": "data/proxy/proxy_domain.txt",
    "isp_output": "data/proxy/proxy_isp.txt",
    "manifest": "data/proxy/.sync-manifest.json",
    "china_domain_urls": [
      "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/china-list.txt"
    ],
    "china_isp_urls": [
      "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/text/cn.txt"
    ],
    "timeout_seconds": 60
  },
  // 生成 SmartDNS 可直接使用的去广告纯域名总表。
  "adblock_aggregate": {
    "enabled": true,
    // 只选每个上游的代表性广告规则，避免把同一规则的 list/yaml 副本重复读取。
    "input_files": [
      "data/acl4ssr/BanAD_domain.txt",
      "data/acl4ssr/BanEasyList_domain.txt",
      "data/acl4ssr/BanEasyListChina_domain.txt",
      "data/acl4ssr/BanEasyPrivacy_domain.txt",
      "data/acl4ssr/BanProgramAD_domain.txt",
      "data/blackmatrix7/Advertising/Advertising.list_domain.txt"
    ],
    // 放行规则中的域名及其子域名不会进入广告总表。
    "exclude_files": [
      "data/acl4ssr/UnBan_domain.txt"
    ],
    "output_dir": "data/adblock",
    "domain_output": "data/adblock/ad_domain.txt",
    "manifest": "data/adblock/.sync-manifest.json",
    // 以下名称和链接会写入广告目录 README。
    "included_rule_names": [
      "ACL4SSR BanAD",
      "ACL4SSR BanEasyList",
      "ACL4SSR BanEasyListChina",
      "ACL4SSR BanEasyPrivacy",
      "ACL4SSR BanProgramAD",
      "BlackMatrix7 Advertising"
    ],
    "excluded_rule_names": [
      "ACL4SSR UnBan"
    ],
    "source_urls": [
      "https://github.com/ACL4SSR/ACL4SSR/tree/master/Clash",
      "https://github.com/blackmatrix7/ios_rule_script/tree/master/rule/Clash/Advertising"
    ]
  },
  // README 中生成订阅 Raw 链接所使用的仓库地址和分支。
  "repository_url": "https://github.com/laoluonb/iKuai-Bypass-rule",
  "repository_branch": "main"
}
