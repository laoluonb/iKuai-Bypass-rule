{
  // 上游同步源列表，可复制下面的对象添加新的链接。
  "sources": [
    {
      // 源名称，同时用于生成文件名。
      "name": "acl4ssr-clash",
      // github_directory 表示同步 GitHub 文件夹。
      "type": "github_directory",
      "upstream_url": "https://github.com/ACL4SSR/ACL4SSR/tree/master/Clash",
      // GitHub Contents API 地址，不是普通网页地址。
      "api_url": "https://api.github.com/repos/ACL4SSR/ACL4SSR/contents/Clash?ref=master",
      // 使用一次性 ZIP，减少递归 Contents API 请求并避免 GitHub API 限流。
      "archive_url": "https://github.com/ACL4SSR/ACL4SSR/archive/refs/heads/master.zip",
      // 去掉上游路径前缀后保留其余文件夹结构。
      "path_prefix": "Clash",
      // 递归同步子文件夹。
      "recursive": true,
      // 要处理的文件扩展名。
      "include_extensions": [".list", ".yaml", ".yml"],
      // 排除的目录和文件。
      "exclude_prefixes": ["Clash/config", "Clash/mrs"],
      "exclude_names": ["GeneralClashConfig.yml"],
      // 生成文件根目录。
      "output_dir": "data/acl4ssr",
      // 域名总表，没有域名内容时不生成。
      "merged_domain_output": "data/acl4ssr/all_domain.txt",
      // ISP 总表，没有 IPv4/CIDR 时不生成。
      "merged_isp_output": "data/acl4ssr/all_isp.txt",
      "timeout_seconds": 30
    },
    {
      // 单个文本规则源。
      "name": "proxy-list",
      "type": "rule_list",
      "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/proxy-list.txt",
      "output_dir": "data/v2ray-rules-dat",
      "timeout_seconds": 30
    },
    {
      // 另一个单个文本规则源。
      "name": "google-cn",
      "type": "rule_list",
      "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/google-cn.txt",
      "output_dir": "data/v2ray-rules-dat",
      "timeout_seconds": 30
    },
    {
      // BlackMatrix7 Clash 目录；扩展名写入输出文件名，避免同名文件覆盖。
      "name": "blackmatrix7-clash",
      "type": "github_directory",
      "upstream_url": "https://github.com/blackmatrix7/ios_rule_script/tree/master/rule/Clash",
      "api_url": "https://api.github.com/repos/blackmatrix7/ios_rule_script/contents/rule/Clash?ref=master",
      "archive_url": "https://github.com/blackmatrix7/ios_rule_script/archive/refs/heads/master.zip",
      "path_prefix": "rule/Clash",
      "recursive": true,
      "include_extensions": [".list", ".yaml", ".yml"],
      "include_source_extension": true,
      "output_dir": "data/blackmatrix7",
      "merged_domain_output": "data/blackmatrix7/all_domain.txt",
      "merged_isp_output": "data/blackmatrix7/all_isp.txt",
      "timeout_seconds": 30
    }
  ],
  // 可选：生成全部同步内容合并后的代理专用列表。
  "proxy_aggregate": {
    "enabled": true,
    "input_dirs": ["data/acl4ssr", "data/v2ray-rules-dat", "data/blackmatrix7"],
    "output_dir": "data/proxy",
    "domain_output": "data/proxy/proxy_domain.txt",
    "isp_output": "data/proxy/proxy_isp.txt",
    "manifest": "data/proxy/.sync-manifest.json",
    "china_domain_urls": [
      "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/china-list.txt"
    ],
    "china_isp_urls": [
      "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/text/cn.txt"
    ],
    "timeout_seconds": 60
  },
  "repository_url": "https://github.com/laoluonb/iKuai-Bypass-rule",
  "repository_branch": "main"
}
